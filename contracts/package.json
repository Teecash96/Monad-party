    "@openzeppelin/contracts": "^5.1.0",
    "@pythnetwork/entropy-sdk-solidity": "^2.2.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
