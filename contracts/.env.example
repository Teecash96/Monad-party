# Monad RPC URLs
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here
MONAD_EXPLORER_API_KEY=

# Verified Pyth Entropy contract for the selected Monad network.
PYTH_ENTROPY_ADDRESS=

# Transaction safety gates. Set only for the command you reviewed.
EXPECTED_CHAIN_ID=10143
CONFIRM_DEPLOY_CHAIN_ID=
CONFIRM_ENTROPY_SMOKE_CHAIN_ID=
CONFIRM_TRANSFER_OWNERSHIP=
NEW_OWNER=
PUBLISHER_ADDRESS=
ELIGIBILITY_REGISTRY_ADDRESS=
PYTH_ENTROPY_COORDINATOR_ADDRESS=
VRF_WRAPPER_ADDRESS=
RAFFLE_CORE_ADDRESS=

# First party daily challenge publisher
PARTY_GAME_ADDRESS=
PARTY_CHALLENGE_DAY=
PARTY_CHALLENGE_ANSWER=
PARTY_CHALLENGE_SALT=
CONFIRM_PARTY_CHALLENGE_CHAIN_ID=

# Optional: Gas reporting
REPORT_GAS=false
