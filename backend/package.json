{
  "name": "monad-raffle-backend",
  "version": "1.0.0",
  "description": "Monad Weekly Raffle Backend Services",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "validate:env": "ts-node src/cli/validateEnv.ts",
    "demo:seed": "ts-node src/cli/seedDemo.ts",
    "indexer": "ts-node src/cron/hourlyIndexer.ts",
