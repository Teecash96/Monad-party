    "sync:winners": "ts-node src/cron/syncWinners.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.7",
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethers": "^6.11.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
